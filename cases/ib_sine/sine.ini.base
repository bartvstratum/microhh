sbot=0.1

[fields]
visc=1e-7
svisc=1e-7

rndseed=1
rndamp=0.0
rndz=0.0

slist=s

[buffer]
swbuffer=0
zstart=4000
sigma=0.002
beta=2.

[time]
starttime=0.
endtime=1200
adaptivestep=true
dtmax=20.
savetime=5
outputiter=50
rkorder=4
iotimeprec=-2

[stats]
swstats=1
sampletime=5
masklist=ib

[cross]
