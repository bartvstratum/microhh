[master]
npx=1
npy=1

[grid]
itot=None
jtot=None
ktot=None

xsize=None
ysize=None
zsize=None

swspatialorder=2

[advec]
cflmax=1.2

[diff]
swdiff=2

[thermo]
swthermo=0

[force]
swlspres=dpdx
dpdx=-6.5e-5

[boundary]
mbcbot=freeslip
mbctop=noslip
sbcbot=neumann
sbctop=neumann
sbot=0.
stop=0.

[IB]
sw_immersed_boundary=dem
n_idw_points=8
